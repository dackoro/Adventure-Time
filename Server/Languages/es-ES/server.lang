npcRoles.AT_Gunter.name = Gunter
npcRoles.AT_Snow_Leopard.name = Leopardo de las nieves
npcRoles.AT_Ice_King.name = Rey Helado
npcRoles.AT_Ice_King_Lightning_Stuck.name = Rayo de hielo
npcRoles.AT_Ice_King_Ice_Pillar.name = Pilar de hielo
items.AT_Ice_King_Crown.name = Corona del Rey Helado
items.AT_Ice_King_Nunchucks.name = Nunchakus de hielo del Rey Helado
items.AT_Ice_King_Warmth_Potion.name = Poción de calor
items.AT_Ice_King_Warmth_Potion.description = Te mantiene caliente 10 minutos: la magia del Rey Helado no puede congelarte, solo te ralentiza un poco, y no te puedes quemar.
items.AT_Ice_King_Rune_Ice_Ray.name = Runa del rayo de hielo
items.AT_Ice_King_Rune_Ice_Ray.description = Lanza el rayo de hielo del Rey Helado: congela un momento lo que toca. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
npcRoles.AT_Snowman.name = Muñeco de nieve
items.AT_Ice_King_Rune_Ice_Nova.name = Runa de la nova de hielo
items.AT_Ice_King_Rune_Ice_Nova.description = Una explosión de hielo a tu alrededor que empuja a los enemigos y les suma dos cargas de escarcha. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Mace.name = Runa del mazo de hielo
items.AT_Ice_King_Rune_Ice_Mace.description = Golpeas el suelo tres veces y cada golpe lanza una onda de hielo. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Sword.name = Runa de la espada de hielo
items.AT_Ice_King_Rune_Ice_Sword.description = El combo de espada de hielo del Rey Helado: dos tajos y un golpe final, avanzando. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Frost_Burst.name = Runa de la ráfaga de hielo
items.AT_Ice_King_Rune_Frost_Burst.description = Diez rayos de hielo rápidos, una mano y luego la otra; con cinco aciertos el objetivo se congela. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Shield.name = Runa del escudo de hielo
items.AT_Ice_King_Rune_Ice_Shield.description = Te cubres con una burbuja de hielo que reduce el daño que recibes y luego estalla, empujando y congelando a quien esté cerca. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.

npcRoles.AT_Gunter.name = Gunter
npcRoles.AT_Snow_Leopard.name = Leopardo de las nieves
npcRoles.AT_Ice_King.name = Rey Helado
npcRoles.AT_Ice_King_Lightning_Stuck.name = Rayo de hielo
npcRoles.AT_Ice_King_Ice_Pillar.name = Pilar de hielo
items.AT_Ice_King_Crown.name = Corona del Rey Helado
items.AT_Ice_King_Nunchucks.name = Nunchakus de hielo del Rey Helado
items.AT_Ice_King_Warmth_Potion.name = Poción de calor
items.AT_Ice_King_Warmth_Potion.description = Te mantiene caliente 10 minutos: la magia del Rey Helado no puede congelarte, solo te ralentiza un poco, y no te puedes quemar.
items.AT_Ice_King_Rune_Ice_Ray.name = Runa del rayo de hielo
items.AT_Ice_King_Rune_Ice_Ray.description = Lanza el rayo de hielo del Rey Helado. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
npcRoles.AT_Snowman.name = Muñeco de nieve
items.AT_Ice_King_Rune_Zap.name = Runa del zap
items.AT_Ice_King_Rune_Zap.description = ¡ZAP! Un rayo de hielo rápido y flojo que suma media carga de escarcha. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Nova.name = Runa de la nova de hielo
items.AT_Ice_King_Rune_Ice_Nova.description = Una explosión de hielo a tu alrededor que empuja a los enemigos y les suma dos cargas de escarcha. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Iceberg.name = Runa del iceberg
items.AT_Ice_King_Rune_Iceberg.description = Deja caer un iceberg donde apuntas. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Rain.name = Runa de la lluvia de hielo
items.AT_Ice_King_Rune_Ice_Rain.description = Durante unos segundos llueven fragmentos de hielo donde apuntas. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Freezing_Ray.name = Runa del rayo congelante
items.AT_Ice_King_Rune_Freezing_Ray.description = El rayo congelante del Rey Helado: congela un momento lo que toca. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Chain_Rays.name = Runa de rayos en cadena
items.AT_Ice_King_Rune_Chain_Rays.description = Un rayo congelante que salta de enemigo en enemigo, hasta cuatro golpes. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ultimate.name = Runa de ¡Hielo... REY!
items.AT_Ice_King_Rune_Ultimate.description = Cargas y lanzas el rayo gigante de escarcha del Rey Helado. El último golpe congela. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Mace.name = Runa del mazo de hielo
items.AT_Ice_King_Rune_Ice_Mace.description = Golpeas el suelo tres veces y cada golpe lanza una onda de hielo. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Sword.name = Runa de la espada de hielo
items.AT_Ice_King_Rune_Ice_Sword.description = El combo de espada de hielo del Rey Helado: dos tajos y un golpe final, avanzando. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Frost_Burst.name = Runa de la ráfaga de hielo
items.AT_Ice_King_Rune_Frost_Burst.description = Cinco rayos de hielo rápidos; si aciertan todos, el objetivo se congela. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Shield.name = Runa del escudo de hielo
items.AT_Ice_King_Rune_Ice_Shield.description = Te cubres con una burbuja de hielo que reduce el daño que recibes y luego estalla, empujando y congelando a quien esté cerca. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
items.AT_Ice_King_Rune_Ice_Lightning.name = Runa del rayo del cielo
items.AT_Ice_King_Rune_Ice_Lightning.description = Hace caer un rayo de hielo gigante del cielo donde apuntas. Necesita magia de hielo: solo funciona con la Corona del Rey Helado puesta.
